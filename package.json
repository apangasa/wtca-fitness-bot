{
  "name": "wtca-fitness-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord bot that tracks WTCA fitness logs and renders charts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "serve": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "register": "tsx src/scripts/register-commands.ts",
    "check": "tsc --noEmit && tsx src/scripts/check-commands.ts && tsx src/scripts/check-weights.ts && tsx src/scripts/check-weights.ts reopen",
    "preview": "tsx src/scripts/preview-charts.ts",
    "queue": "tsx src/scripts/queue.ts",
    "approve": "tsx src/scripts/approve-exercise.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "luxon": "^3.5.0",
    "playwright": "^1.48.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
