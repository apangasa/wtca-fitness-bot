# --- Discord credentials (from https://discord.com/developers/applications) ---
# Bot -> Token -> Reset Token
DISCORD_TOKEN=
# General Information -> Application ID
DISCORD_CLIENT_ID=
# Right-click your server -> Copy Server ID (needs Developer Mode on)
DISCORD_GUILD_ID=

# --- Behaviour ---
# Channel the daily recap gets posted to. Right-click #fitness -> Copy Channel ID.
# Can also be set at runtime with /config channel.
RECAP_CHANNEL_ID=

# IANA timezone used for day boundaries and recap timing.
TZ_NAME=America/New_York

# Hour (0-23, local to TZ_NAME) at which a new fitness day starts.
# 4 means anything logged before 4am counts toward the previous day.
DAY_CUTOFF_HOUR=4

# Local time the daily recap is posted, HH:MM 24h.
# The recap summarises the day that just CLOSED, so this must be at or after
# DAY_CUTOFF_HOUR. Leave blank to default to the cutoff + 5 minutes.
RECAP_TIME=04:05

# --- Storage ---
# Kept out of OneDrive on purpose: OneDrive's file sync corrupts live SQLite files.
# Leave blank to use %LOCALAPPDATA%\wtca-fitness-bot\fitness.db
DB_PATH=
